{
  "name": "facet-crm-client",
  "version": "1.0.0",
  "description": "Facet Renovations CRM Client",
  "productName": "Facet CRM",
  "author": "Facet Renovations",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.9",
    "axios": "^1.15.0",
    "pinia": "^2.1.7",
    "quasar": "^2.18.7",
    "socket.io-client": "^4.7.2",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.5.2",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^1.2.4",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "playwright": "^1.59.1",
    "prettier": "^3.1.1",
    "socket.io-mock": "^1.3.2",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.6.2"
  },
  "engines": {
    "node": "^20 || ^18 || ^16",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
