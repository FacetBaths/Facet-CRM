{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es5", "es2015", "es2016", "es2020", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "types": ["node", "jest"]
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "__tests__/**/*", "tests/**/*", "jest.config.ts", "jest.setup.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
